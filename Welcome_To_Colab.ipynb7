        "<a href=\"https://colab.research.google.com/github/MANCHAKRISHNA/FSD_UNIT1/blob/main/Welcome_To_Colab.ipynb7\" target=\"_parent\"><img src=\"https://colab.research.google.com/assets/colab-badge.svg\" alt=\"Open In Colab\"/></a>"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Module 3: Vision Transformers in Keras\n",
        "\n",
        "import tensorflow as tf\n",
        "from tensorflow.keras.models import load_model\n",
        "from tensorflow.keras.optimizers import Adam\n",
        "\n",
        "# -----------------------------\n",
        "# Task 1: Load the pre-trained CNN model and print summary\n",
        "# -----------------------------\n",
        "cnn_model_path = \"/content/best_model.h5\"  # Replaced with a plausible model path\n",
        "cnn_model = load_model(cnn_model_path)\n",
        "print(\"CNN Model Summary:\")\n",
        "cnn_model.summary()\n",
        "\n",
        "# -----------------------------\n",
        "# Task 2: Get the name of the layer for feature extraction\n",
        "# -----------------------------\n",
        "# Replace this manually based on your cnn_model.summary() output.\n",
        "# Look for a convolutional or pooling layer name that precedes the classification head.\n",
        "# For example, if your summary shows layers like 'conv2d', 'max_pooling2d', 'conv2d_1', 'max_pooling2d_1', etc.,\n",
        "# choose one of those appropriate for feature extraction (e.g., the last convolutional layer before flattening).\n",
        "feature_layer_name = \"conv2d_3\"  # Example layer name, change according to your model\n",
        "print(\"\\nFeature extraction layer name:\", feature_layer_name)\n",
        "\n",
        "# -----------------------------\n",
        "# Task 3: Define hybrid CNN-ViT model\n",
        "# -----------------------------\n",
        "from tensorflow.keras import layers, Model\n",
        "\n",
        "def build_cnn_vit_hybrid(cnn_model, feature_layer_name, num_classes=2):\n",
        "    \"\"\"\n",
        "    Builds a hybrid CNN + Vision Transformer model.\n",
        "    cnn_model: pre-trained CNN model\n",
        "    feature_layer_name: layer name from CNN for feature extraction\n",
        "    num_classes: number of output classes\n",
        "    \"\"\"\n",
        "    # Feature extraction\n",
        "    feature_layer = cnn_model.get_layer(feature_layer_name).output\n",
        "\n",
        "    # Flatten features\n",
        "    x = layers.Flatten()(feature_layer)\n",
        "\n",
        "    # Vision Transformer block (simplified for demonstration)\n",
        "    # Typically, ViT uses patches + multi-head self-attention\n",
        "    vit_input = layers.Reshape((x.shape[1], 1))(x)\n",
        "    attention = layers.MultiHeadAttention(num_heads=4, key_dim=32)(vit_input, vit_input)\n",
        "    x = layers.GlobalAveragePooling1D()(attention)\n",
        "\n",
        "    # Output layer\n",
        "    output = layers.Dense(num_classes, activation='softmax')(x)\n",
        "\n",
        "    hybrid_model = Model(inputs=cnn_model.input, outputs=output)\n",
        "    return hybrid_model\n",
        "\n",
        "num_classes = 2  # Change if your dataset has more classes\n",
        "hybrid_model = build_cnn_vit_hybrid(cnn_model, feature_layer_name, num_classes)\n",
        "print(\"\\nHybrid Model Summary:\")\n",
        "hybrid_model.summary()\n",
        "\n",
        "# -----------------------------\n",
        "# Task 4: Compile the hybrid_model\n",
        "# -----------------------------\n",
        "hybrid_model.compile(\n",
        "    optimizer=Adam(learning_rate=0.0001),\n",
        "    loss='categorical_crossentropy',\n",
        "    metrics=['accuracy']\n",
        ")\n",
        "\n",
        "# -----------------------------\n",
        "# Task 5: Define training configuration\n",
        "# -----------------------------\n",
        "from tensorflow.keras.callbacks import ModelCheckpoint, EarlyStopping\n",
        "\n",
        "# Example configuration\n",
        "batch_size = 16\n",
        "epochs = 20\n",
        "\n",
        "# Callbacks\n",
        "checkpoint_cb = ModelCheckpoint(\n",
        "    \"best_hybrid_model.h5\",\n",
        "    monitor=\"val_accuracy\",\n",
        "    save_best_only=True,\n",
        "    mode=\"max\",\n",
        "    verbose=1\n",
        ")\n",
        "\n",
        "earlystop_cb = EarlyStopping(\n",
        "    monitor=\"val_loss\",\n",
        "    patience=5,\n",
        "    restore_best_weights=True,\n",
        "    verbose=1\n",
        ")\n",
        "\n",
        "print(\"\\nTraining Configuration:\")\n",
        "print(f\"Batch size: {batch_size}\")\n",
        "print(f\"Epochs: {epochs}\")\n",
        "print(\"Callbacks: checkpoint and early stopping ready\")"
      ],
