    },
    {
      "cell_type": "code",
      "source": [
        "# Module 1: Data Loading and Augmentation Using PyTorch\n",
        "\n",
        "import torch\n",
        "from torch.utils.data import DataLoader\n",
        "from torchvision import datasets, transforms\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "\n",
        "# -----------------------------\n",
        "# Task 1: Create transformation pipeline\n",
        "# -----------------------------\n",
        "custom_transform = transforms.Compose([\n",
        "    transforms.Resize((64, 64)),\n",
        "    transforms.RandomHorizontalFlip(p=0.5),\n",
        "    transforms.RandomVerticalFlip(p=0.2),\n",
        "    transforms.RandomRotation(degrees=45),\n",
        "    transforms.ToTensor()  # Convert image to PyTorch tensor\n",
        "])\n",
        "\n",
        "# -----------------------------\n",
        "# Task 2: Load the dataset using ImageFolder\n",
        "# -----------------------------\n",
        "# Replace this path with your dataset folder containing class subfolders\n",
        "dataset_path = \"./images_dataSAT\"  # e.g., \"dataset/class_0_non_agri and class_1_agri\"\n",
        "imagefolder_dataset = datasets.ImageFolder(root=dataset_path, transform=custom_transform)\n",
        "\n",
        "print(f\"Total images in dataset: {len(imagefolder_dataset)}\")\n",
        "\n",
        "# -----------------------------\n",
        "# Task 3: Print names and class indices\n",
        "# -----------------------------\n",
        "print(\"\\nSample dataset entries:\")\n",
        "for idx in range(min(5, len(imagefolder_dataset))):\n",
        "    img_path, label = imagefolder_dataset.imgs[idx]  # .imgs returns (path, class_idx)\n",
        "    print(f\"Image Path: {img_path}, Class Index: {label}\")\n",
        "\n",
        "# -----------------------------\n",
        "# Task 4: Retrieve a batch of images and labels\n",
        "# -----------------------------\n",
        "batch_size = 8\n",
        "imagefolder_loader = DataLoader(imagefolder_dataset, batch_size=batch_size, shuffle=True)\n",
        "\n",
        "# Get one batch\n",
        "images, labels = next(iter(imagefolder_loader))\n",
        "print(\"\\nBatch shapes:\")\n",
        "print(\"Images shape:\", images.shape)  # Should be [batch_size, 3, 64, 64]\n",
        "print(\"Labels shape:\", labels.shape)  # Should be [batch_size]\n",
        "\n",
        "# -----------------------------\n",
        "# Task 5: Display images from the batch\n",
        "# -----------------------------\n",
        "def imshow_batch(img_batch, label_batch):\n",
        "    img_batch = img_batch.numpy().transpose((0, 2, 3, 1))  # Convert to [batch, H, W, C]\n",
        "    fig, axes = plt.subplots(1, len(img_batch), figsize=(15, 5))\n",
        "    if len(img_batch) == 1:\n",
        "        axes = [axes]\n",
        "    for i, ax in enumerate(axes):\n",
        "        ax.imshow(img_batch[i])\n",
        "        ax.set_title(f\"Label: {label_batch[i].item()}\")\n",
        "        ax.axis('off')\n",
        "    plt.show()\n",
        "\n",
        "imshow_batch(images, labels)"
      ],
      "metadata": {
