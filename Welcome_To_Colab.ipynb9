      "source": [
        "import torch\n",
        "import torch.nn as nn\n",
        "\n",
        "# Define a dummy CNNViTHybrid model to save (matching the architecture)\n",
        "class CNNViTHybrid(nn.Module):\n",
        "    def __init__(self, num_classes=2, embed_dim=128, mlp_heads=4, transformer_depth=2):\n",
        "        super(CNNViTHybrid, self).__init__()\n",
        "        self.cnn = nn.Sequential(\n",
        "            nn.Conv2d(3, 32, 3, padding=1), nn.ReLU(), nn.MaxPool2d(2,2),\n",
        "            nn.Conv2d(32, 64, 3, padding=1), nn.ReLU(), nn.MaxPool2d(2,2),\n",
        "            nn.Conv2d(64, 128, 3, padding=1), nn.ReLU(), nn.MaxPool2d(2,2)\n",
        "        )\n",
        "        self.flatten = nn.Flatten()\n",
        "        self.fc_embed = nn.Linear(128*8*8, embed_dim)\n",
        "        encoder_layer = nn.TransformerEncoderLayer(d_model=embed_dim, nhead=mlp_heads, batch_first=True)\n",
        "        self.transformer = nn.TransformerEncoder(encoder_layer, num_layers=transformer_depth)\n",
        "        self.fc_out = nn.Linear(embed_dim, num_classes)\n",
        "\n",
        "    def forward(self, x):\n",
        "        x = self.cnn(x)\n",
        "        x = self.flatten(x)\n",
        "        x = self.fc_embed(x)\n",
        "        x = x.unsqueeze(1)  # (batch_size, seq_len=1, embed_dim)\n",
        "        x = self.transformer(x)\n",
        "        x = x.mean(dim=1)\n",
        "        x = self.fc_out(x)\n",
        "        return x\n",
        "\n",
        "\n",
        "# Create an instance of the dummy model\n",
        "dummy_model_pt = CNNViTHybrid(num_classes=2)\n",
        "\n",
        "# Define a path to save the dummy model\n",
        "dummy_pytorch_model_path = \"./dummy_pytorch_cnn_vit_hybrid.pth\"\n",
        "\n",
        "# Save the state_dict of the dummy model\n",
        "torch.save(dummy_model_pt.state_dict(), dummy_pytorch_model_path)\n",
        "\n",
        "print(f\"Dummy PyTorch model saved to: {dummy_pytorch_model_path}\")"
      ],
      "execution_count": 32,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Dummy PyTorch model saved to: ./dummy_pytorch_cnn_vit_hybrid.pth\n"
          ]
        }
      ]
