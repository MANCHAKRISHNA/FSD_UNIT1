    },
    {
      "cell_type": "code",
      "source": [
        "# Module 3: Land Classification – CNN-Transformer Integration Evaluation\n",
        "\n",
        "import os\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "from torch.utils.data import DataLoader\n",
        "from torchvision import datasets, transforms\n",
        "import numpy as np\n",
        "from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, confusion_matrix\n",
        "import tensorflow as tf\n",
        "from tensorflow.keras.models import load_model\n",
        "from tensorflow.keras.preprocessing import image\n",
        "\n",
        "# -----------------------------\n",
        "# Function to print evaluation metrics\n",
        "# -----------------------------\n",
        "def print_metrics(y_true, y_pred):\n",
        "    acc = accuracy_score(y_true, y_pred)\n",
        "    prec = precision_score(y_true, y_pred, zero_division=0)\n",
        "    rec = recall_score(y_true, y_pred, zero_division=0)\n",
        "    f1 = f1_score(y_true, y_pred, zero_division=0)\n",
        "    cm = confusion_matrix(y_true, y_pred)\n",
        "    print(\"Accuracy:\", acc)\n",
        "    print(\"Precision:\", prec)\n",
        "    print(\"Recall:\", rec)\n",
        "    print(\"F1 Score:\", f1)\n",
        "    print(\"Confusion Matrix:\\n\", cm)\n",
        "\n",
        "# -----------------------------\n",
        "# Task 1: Define dataset directory, dataloader, and hyperparameters\n",
        "# -----------------------------\n",
        "# Assume standard folder structure:\n",
        "# val_dataset/\n",
        "# └── class_0_non_agri/\n",
        "# └── class_1_agri/\n",
        "\n",
        "val_dataset_path = \"./images_dataSAT\"  # Corrected path for validation dataset\n",
        "batch_size = 16\n",
        "num_classes = 2\n",
        "\n",
        "val_transform = transforms.Compose([\n",
        "    transforms.Resize((64, 64)),\n",
        "    transforms.ToTensor()\n",
        "])\n",
        "\n",
        "val_dataset = datasets.ImageFolder(root=val_dataset_path, transform=val_transform)\n",
        "val_loader = DataLoader(val_dataset, batch_size=batch_size, shuffle=False)\n",
        "print(f\"Validation samples: {len(val_dataset)}\")\n",
        "\n",
        "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "\n",
        "# -----------------------------\n",
        "# Task 2: PyTorch CNN-ViT Hybrid Model\n",
        "# -----------------------------\n",
        "class CNNViTHybrid(nn.Module):\n",
        "    def __init__(self, num_classes=2, embed_dim=128, mlp_heads=4, transformer_depth=2):\n",
        "        super(CNNViTHybrid, self).__init__()\n",
        "        self.cnn = nn.Sequential(\n",
        "            nn.Conv2d(3, 32, 3, padding=1), nn.ReLU(), nn.MaxPool2d(2,2),\n",
        "            nn.Conv2d(32, 64, 3, padding=1), nn.ReLU(), nn.MaxPool2d(2,2),\n",
        "            nn.Conv2d(64, 128, 3, padding=1), nn.ReLU(), nn.MaxPool2d(2,2)\n",
        "        )\n",
        "        self.flatten = nn.Flatten()\n",
        "        self.fc_embed = nn.Linear(128*8*8, embed_dim)\n",
        "        # Set batch_first=True for the TransformerEncoderLayer to handle batch dimension correctly\n",
        "        encoder_layer = nn.TransformerEncoderLayer(d_model=embed_dim, nhead=mlp_heads, batch_first=True)\n",
        "        self.transformer = nn.TransformerEncoder(encoder_layer, num_layers=transformer_depth)\n",
        "        self.fc_out = nn.Linear(embed_dim, num_classes)\n",
        "\n",
        "    def forward(self, x):\n",
        "        x = self.cnn(x)\n",
        "        x = self.flatten(x)\n",
        "        x = self.fc_embed(x)\n",
        "        # Change unsqueeze dim from 0 to 1 as batch_first=True\n",
        "        x = x.unsqueeze(1)  # (batch_size, seq_len=1, embed_dim)\n",
        "        x = self.transformer(x)\n",
        "        # Change mean dim from 0 to 1 for global average pooling over sequence length\n",
        "        x = x.mean(dim=1)\n",
        "        x = self.fc_out(x)\n",
        "        return x\n",
        "\n",
        "# Instantiate PyTorch model and load trained weights\n",
        "pytorch_model_path = \"models/pytorch_cnn_vit_hybrid.pth\"  # Set correct path\n",
        "model_pt = CNNViTHybrid(num_classes=num_classes).to(device)\n",
        "model_pt.load_state_dict(torch.load(pytorch_model_path, map_location=device))\n",
        "model_pt.eval()\n",
        "\n",
        "# -----------------------------\n",
        "# Task 3: Evaluate Keras CNN-ViT Hybrid Model\n",
        "# -----------------------------\n",
        "keras_model_path = \"models/keras_cnn_vit_hybrid.h5\"  # Set correct path\n",
        "keras_model = load_model(keras_model_path)\n",
        "\n",
        "# Prepare validation data for Keras\n",
        "val_image_paths = []\n",
        "val_labels = []\n",
        "\n",
        "for class_name, idx in val_dataset.class_to_idx.items():\n",
        "    class_dir = os.path.join(val_dataset_path, class_name)\n",
        "    for fname in os.listdir(class_dir):\n",
        "        if fname.lower().endswith(('.png', '.jpg', '.jpeg')):\n",
        "            val_image_paths.append(os.path.join(class_dir, fname))\n",
        "            val_labels.append(idx)\n",
        "\n",
        "# Load and preprocess images\n",
        "def load_and_preprocess(img_paths):\n",
        "    imgs = []\n",
        "    for path in img_paths:\n",
        "        img = image.load_img(path, target_size=(64,64))\n",
        "        img = image.img_to_array(img)\n",
        "        img = img / 255.0\n",
        "        imgs.append(img)\n",
        "    return np.array(imgs)\n",
        "\n",
        "X_val_keras = load_and_preprocess(val_image_paths)\n",
        "y_true_keras = np.array(val_labels)\n",
        "\n",
        "y_pred_probs_keras = keras_model.predict(X_val_keras, batch_size=batch_size)\n",
        "y_pred_keras = (y_pred_probs_keras > 0.5).astype(int).flatten()\n",
        "\n",
        "print(\"\\nKeras CNN-ViT Hybrid Model Metrics:\")\n",
        "print_metrics(y_true_keras, y_pred_keras)\n",
        "\n",
        "# -----------------------------\n",
        "# Task 4: Evaluate PyTorch CNN-ViT Hybrid Model\n",
        "# -----------------------------\n",
        "y_true_pt = []\n",
        "y_pred_pt = []\n",
        "\n",
        "with torch.no_grad():\n",
        "    for images, labels in val_loader:\n",
        "        images, labels = images.to(device), labels.to(device)\n",
        "        outputs = model_pt(images)\n",
        "        _, preds = torch.max(outputs, 1)\n",
        "        y_true_pt.extend(labels.cpu().numpy())\n",
        "        y_pred_pt.extend(preds.cpu().numpy())\n",
        "\n",
        "print(\"\\nPyTorch CNN-ViT Hybrid Model Metrics:\")\n",
        "print_metrics(np.array(y_true_pt), np.array(y_pred_pt))"
      ],
