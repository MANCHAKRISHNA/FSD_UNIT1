    {
      "cell_type": "code",
      "source": [
        "# =========================\n",
        "# Import Libraries\n",
        "# =========================\n",
        "import os\n",
        "import matplotlib.pyplot as plt\n",
        "import matplotlib.image as mpimg\n",
        "import numpy as np # Added for creating dummy image data\n",
        "from PIL import Image # Added for saving dummy images\n",
        "\n",
        "# =========================\n",
        "# Define Directories\n",
        "# =========================\n",
        "non_agri_dir = './images_dataSAT/class_0_non_agri/'\n",
        "agri_dir = './images_dataSAT/class_1_agri/'\n",
        "\n",
        "# =========================\n",
        "# Ensure directories exist and create dummy images for testing\n",
        "# =========================\n",
        "if not os.path.exists(non_agri_dir):\n",
        "    os.makedirs(non_agri_dir)\n",
        "    print(f\"Created directory: {non_agri_dir}\")\n",
        "    # Create dummy images\n",
        "    for i in range(5):\n",
        "        dummy_image_path = os.path.join(non_agri_dir, f'dummy_non_agri_{i}.jpg')\n",
        "        dummy_image_data = np.random.randint(0, 256, (100, 100, 3), dtype=np.uint8)\n",
        "        img = Image.fromarray(dummy_image_data)\n",
        "        img.save(dummy_image_path)\n",
        "        print(f\"Created dummy image: {dummy_image_path}\")\n",
        "\n",
        "if not os.path.exists(agri_dir):\n",
        "    os.makedirs(agri_dir)\n",
        "    print(f\"Created directory: {agri_dir}\")\n",
        "    # Create dummy images\n",
        "    for i in range(5):\n",
        "        dummy_image_path = os.path.join(agri_dir, f'dummy_agri_{i}.jpg')\n",
        "        dummy_image_data = np.random.randint(0, 256, (100, 100, 3), dtype=np.uint8)\n",
        "        img = Image.fromarray(dummy_image_data)\n",
        "        img.save(dummy_image_path)\n",
        "        print(f\"Created dummy image: {dummy_image_path}\")\n",
        "\n",
        "# =========================\n",
        "# Get file lists (SORTED)\n",
        "# =========================\n",
        "non_agri_images = sorted(os.listdir(non_agri_dir))\n",
        "agri_images = sorted(os.listdir(agri_dir))\n",
        "\n",
        "# Convert filenames to full paths\n",
        "non_agri_paths = [os.path.join(non_agri_dir, img) for img in non_agri_images]\n",
        "agri_images_paths = [os.path.join(agri_dir, img) for img in agri_images]\n",
        "\n",
        "# =========================\n",
        "# Task 1: Image Shape\n",
        "# =========================\n",
        "image_data = mpimg.imread(non_agri_paths[0])\n",
        "print(\"Task 1: Image Shape:\", image_data.shape)\n",
        "\n",
        "# =========================\n",
        "# Task 2: First 4 Non-Agri Images\n",
        "# =========================\n",
        "plt.figure(figsize=(10, 8))\n",
        "for i in range(4):\n",
        "    img = mpimg.imread(non_agri_paths[i])\n",
        "    plt.subplot(2, 2, i+1)\n",
        "    plt.imshow(img)\n",
        "    plt.axis('off')\n",
        "plt.show()\n",
        "\n",
        "# =========================\n",
        "# Task 3: Sorted Agri Paths\n",
        "# =========================\n",
        "agri_images_paths = sorted(agri_images_paths)\n",
        "\n",
        "print(\"\\nTask 3: First 5 paths:\")\n",
        "for path in agri_images_paths[:5]:\n",
        "    print(path)\n",
        "\n",
        "# =========================\n",
        "# Task 4: Count Agri Images\n",
        "# =========================\n",
        "print(\"\\nTask 4: Number of agri images:\", len(agri_images_paths))\n",
        "\n",
        "# =========================\n",
        "# Task 5: First 4 Agri Images\n",
        "# =========================\n",
        "plt.figure(figsize=(10, 8))\n",
        "for i in range(4):\n",
        "    img = mpimg.imread(agri_images_paths[i])\n",
        "    plt.subplot(2, 2, i+1)\n",
        "    plt.imshow(img)\n",
        "    plt.axis('off')\n",
        "plt.show()"
      ],
