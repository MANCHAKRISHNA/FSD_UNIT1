        "<a href=\"https://colab.research.google.com/github/MANCHAKRISHNA/FSD_UNIT1/blob/main/Welcome_To_Colab.ipynb8\" target=\"_parent\"><img src=\"https://colab.research.google.com/assets/colab-badge.svg\" alt=\"Open In Colab\"/></a>"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Module 3: Vision Transformers in PyTorch (Corrected Executable Version)\n",
        "\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.optim as optim\n",
        "from torch.utils.data import DataLoader\n",
        "from torchvision import datasets, transforms\n",
        "import matplotlib.pyplot as plt\n",
        "import time\n",
        "\n",
        "# -----------------------------\n",
        "# Task 1: Train Transform\n",
        "# -----------------------------\n",
        "train_transform = transforms.Compose([\n",
        "    transforms.Resize((64, 64)),\n",
        "    transforms.RandomHorizontalFlip(p=0.5),\n",
        "    transforms.RandomVerticalFlip(p=0.2),\n",
        "    transforms.RandomRotation(degrees=45),\n",
        "    transforms.ToTensor()\n",
        "])\n",
        "\n",
        "# -----------------------------\n",
        "# Task 2: Validation Transform\n",
        "# -----------------------------\n",
        "val_transform = transforms.Compose([\n",
        "    transforms.Resize((64, 64)),\n",
        "    transforms.ToTensor()\n",
        "])\n",
        "\n",
        "# -----------------------------\n",
        "# Dataset Paths\n",
        "# -----------------------------\n",
        "train_dataset_path = \"./images_dataSAT\"  # Replace with actual path\n",
        "val_dataset_path = \"./images_dataSAT\"      # Replace with actual path\n",
        "\n",
        "# -----------------------------\n",
        "# Task 3: Dataloaders\n",
        "# -----------------------------\n",
        "train_dataset = datasets.ImageFolder(root=train_dataset_path, transform=train_transform)\n",
        "val_dataset = datasets.ImageFolder(root=val_dataset_path, transform=val_transform)\n",
        "\n",
        "train_loader = DataLoader(train_dataset, batch_size=16, shuffle=True)\n",
        "val_loader = DataLoader(val_dataset, batch_size=16, shuffle=False)\n",
        "\n",
        "print(f\"Train samples: {len(train_dataset)}, Validation samples: {len(val_dataset)}\")\n",
        "\n",
        "# -----------------------------\n",
        "# Task 4: CNN-ViT Hybrid Model\n",
        "# -----------------------------\n",
        "class CNNViTHybrid(nn.Module):\n",
        "    def __init__(self, num_classes=2, embed_dim=128, mlp_heads=4, transformer_depth=2):\n",
        "        super(CNNViTHybrid, self).__init__()\n",
        "        # CNN feature extractor\n",
        "        self.cnn = nn.Sequential(\n",
        "            nn.Conv2d(3, 32, 3, padding=1), nn.ReLU(), nn.MaxPool2d(2,2),\n",
        "            nn.Conv2d(32, 64, 3, padding=1), nn.ReLU(), nn.MaxPool2d(2,2),\n",
        "            nn.Conv2d(64, 128, 3, padding=1), nn.ReLU(), nn.MaxPool2d(2,2)\n",
        "        )\n",
        "        # Flatten features to sequence for transformer\n",
        "        self.flatten = nn.Flatten()\n",
        "        self.embed_dim = embed_dim\n",
        "        self.fc_embed = nn.Linear(128*8*8, embed_dim)  # 64x64 input → 8x8 after pooling\n",
        "        # Transformer encoder\n",
        "        encoder_layer = nn.TransformerEncoderLayer(d_model=embed_dim, nhead=mlp_heads, batch_first=True)\n",
        "        self.transformer = nn.TransformerEncoder(encoder_layer, num_layers=transformer_depth)\n",
        "        self.fc_out = nn.Linear(embed_dim, num_classes)\n",
        "\n",
        "    def forward(self, x):\n",
        "        x = self.cnn(x)                 # CNN features\n",
        "        x = self.flatten(x)             # Flatten\n",
        "        x = self.fc_embed(x)            # Embed to transformer dimension\n",
        "        x = x.unsqueeze(1)              # Add seq_len=1 for transformer (batch_first is True now)\n",
        "        x = self.transformer(x)         # Transformer encoding\n",
        "        x = x.mean(dim=1)               # Global average pooling over seq\n",
        "        x = self.fc_out(x)\n",
        "        return x\n",
        "\n",
        "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "model_test = CNNViTHybrid(num_classes=len(train_dataset.classes)).to(device)\n",
        "criterion = nn.CrossEntropyLoss()\n",
        "optimizer = optim.Adam(model_test.parameters(), lr=0.001)\n",
        "\n",
        "# -----------------------------\n",
        "# Task 4: Training Loop\n",
        "# -----------------------------\n",
        "epochs = 5\n",
        "train_losses = []\n",
        "val_losses = []\n",
        "train_times = []\n",
        "\n",
        "for epoch in range(epochs):\n",
        "    start_time = time.time()\n",
        "    model_test.train()\n",
        "    running_loss = 0\n",
        "    for images, labels in train_loader:\n",
        "        images, labels = images.to(device), labels.to(device)\n",
        "        optimizer.zero_grad()\n",
        "        outputs = model_test(images)\n",
        "        loss = criterion(outputs, labels)\n",
        "        loss.backward()\n",
        "        optimizer.step()\n",
        "        running_loss += loss.item()\n",
        "    train_losses.append(running_loss / len(train_loader))\n",
        "    train_times.append(time.time() - start_time)\n",
        "\n",
        "    # Validation\n",
        "    model_test.eval()\n",
        "    val_loss = 0\n",
        "    with torch.no_grad():\n",
        "        for images, labels in val_loader:\n",
        "            images, labels = images.to(device), labels.to(device)\n",
        "            outputs = model_test(images)\n",
        "            loss = criterion(outputs, labels)\n",
        "            val_loss += loss.item()\n",
        "    val_losses.append(val_loss / len(val_loader))\n",
        "    print(f\"Epoch {epoch+1}, Train Loss: {train_losses[-1]:.4f}, Val Loss: {val_losses[-1]:.4f}, Time: {train_times[-1]:.2f}s\")\n",
        "\n",
        "# -----------------------------\n",
        "# Task 5: Compare Validation Loss\n",
        "# -----------------------------\n",
        "# Replace with previous model validation loss if available\n",
        "previous_model_val_losses = [0.8, 0.6, 0.5, 0.45, 0.42]  # Example\n",
        "\n",
        "plt.figure(figsize=(8,5))\n",
        "plt.plot(previous_model_val_losses, label=\"Previous Model\")\n",
        "plt.plot(val_losses, label=\"CNN-ViT Hybrid Model\")\n",
        "plt.title(\"Validation Loss Comparison\")\n",
        "plt.xlabel(\"Epochs\")\n",
        "plt.ylabel(\"Loss\")\n",
        "plt.legend()\n",
        "plt.show()\n",
        "\n",
        "# -----------------------------\n",
        "# Task 6: Compare Training Times\n",
        "# -----------------------------\n",
        "# Replace with previous model training times if available\n",
        "previous_model_times = [12, 11, 11, 10, 10]  # Example in seconds\n",
        "\n",
        "plt.figure(figsize=(8,5))\n",
        "plt.plot(previous_model_times, label=\"Previous Model\")\n",
        "plt.plot(train_times, label=\"CNN-ViT Hybrid Model\")\n",
        "plt.title(\"Training Time per Epoch Comparison\")\n",
        "plt.xlabel(\"Epochs\")\n",
        "plt.ylabel(\"Time (s)\")\n",
        "plt.legend()\n",
        "plt.show()"
      ],
